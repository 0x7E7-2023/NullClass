<?xml version="1.0" encoding="utf-8"?>
<!-- 108dp 安全区内 54x54 的日历图形 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.5"
        android:scaleY="0.5"
        android:translateX="27"
        android:translateY="27">

        <!-- 日历主体，中间挖出窗口 -->
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M10,12 h36 a4,4 0 0 1 4,4 v26 a4,4 0 0 1 -4,4 h-36 a4,4 0 0 1 -4,-4 v-26 a4,4 0 0 1 4,-4 z M12,22 h32 v20 h-32 z" />

        <!-- 顶部两个挂耳 -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M14,6 h4 a1,1 0 0 1 1,1 v7 h-6 v-7 a1,1 0 0 1 1,-1 z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M34,6 h4 a1,1 0 0 1 1,1 v7 h-6 v-7 a1,1 0 0 1 1,-1 z" />

        <!-- 窗口里的一节“课” -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M16,26 h12 v6 h-12 z" />
        <path
            android:fillColor="#66FFFFFF"
            android:pathData="M30,26 h8 v6 h-8 z" />
        <path
            android:fillColor="#66FFFFFF"
            android:pathData="M16,34 h22 v4 h-22 z" />
    </group>
</vector>
