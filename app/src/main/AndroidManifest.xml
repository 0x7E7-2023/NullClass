<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机对账（SystemEventReceiver）：normal 权限，安装即授予，无任何用户操作 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 节假日在线同步：okhttp 拉取 timor.tech / Nager.Date -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 扫码导入课表：quickie 扫码页会现场申请；不声明 required 以免没相机的设备装不上 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- 可选精确提醒：用户在「通知与提醒」页主动开启并授权后生效 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 勿扰模式下响铃：可选，授权后才能把提醒渠道设为绕过勿扰 -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- 厂商自启动页跳转（BackgroundReliability）需要包可见性：Android 11+ 不声明
         <queries> 时 PackageManager 解析别家 Activity 一律 NameNotFoundException，
         自启动入口会静默消失。只是可见性声明，不是权限。 -->
    <queries>
        <package android:name="com.miui.securitycenter" />          <!-- 小米 -->
        <package android:name="com.huawei.systemmanager" />          <!-- 华为 -->
        <package android:name="com.hihonor.systemmanager" />         <!-- 荣耀 -->
        <package android:name="com.coloros.safecenter" />            <!-- OPPO / 一加 -->
        <package android:name="com.oppo.safe" />                     <!-- 旧 OPPO -->
        <package android:name="com.vivo.permissionmanager" />        <!-- vivo -->
        <package android:name="com.iqoo.secure" />                   <!-- iQOO -->
        <package android:name="com.meizu.safe" />                    <!-- 魅族 -->
    </queries>

    <application
        android:name=".NullClassApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.NullClass">

        <!-- WorkManager 改为按需初始化（Configuration.Provider + HiltWorkerFactory） -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- 分享 cacheDir/shared/ 下的导出文件与二维码图片 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 系统事件对账：开机/应用更新/改时间/换时区 → 刷小组件 + 重排提醒。
             全部是 protected broadcast，exported=false 只收系统的。
             SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED：精确闹钟授权被授予/收回
             （B1 修复——授权后若不重排，提醒会一直留在 WorkManager 非精确路径）。 -->
        <receiver
            android:name=".notification.SystemEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 精确闹钟到点投递（ExactAlarmScheduler 排的课表提醒） -->
        <receiver
            android:name=".notification.AlarmReceiver"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 系统「用其他应用打开」.nullclass 文件：声明 MIME -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/x-nullclass" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <!-- 扩展名兜底（B6）：.nullclass 未注册进系统 MIME 表，文件管理器/下载器常给
                 application/octet-stream 或不带类型，按文件后缀匹配（pathPattern 需同时声明
                 scheme+host 才生效） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.nullclass" />
            </intent-filter>
        </activity>
    </application>

</manifest>
