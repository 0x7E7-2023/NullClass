         Week = S (semaine), period = P (période), block = B (bloc). -->
    <string-array name="fmt_day_of_week">
        <item>lun.</item>
        <item>mar.</item>
        <item>mer.</item>
        <item>jeu.</item>
        <item>ven.</item>
        <item>sam.</item>
        <item>dim.</item>
    </string-array>
    <string-array name="fmt_day_of_week_short">
        <item>Lu</item>
        <item>Ma</item>
        <item>Me</item>
        <item>Je</item>
        <item>Ve</item>
        <item>Sa</item>
        <item>Di</item>
    </string-array>
    <string name="fmt_day_of_week_unknown">?</string>

    <string name="fmt_week_single">Semaine %1$d</string>
    <string name="fmt_week_range">Semaines %1$d–%2$d</string>
