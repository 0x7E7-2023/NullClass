    <!-- ScheduleText. Timetable cells and widgets are very narrow, so these labels are compact. -->
    <string-array name="fmt_day_of_week">
        <item>月曜</item>
        <item>火曜</item>
        <item>水曜</item>
        <item>木曜</item>
        <item>金曜</item>
        <item>土曜</item>
        <item>日曜</item>
    </string-array>
    <string-array name="fmt_day_of_week_short">
        <item>月</item>
        <item>火</item>
        <item>水</item>
        <item>木</item>
        <item>金</item>
        <item>土</item>
        <item>日</item>
    </string-array>
    <string name="fmt_day_of_week_unknown">?</string>

    <string name="fmt_week_single">第%1$d週</string>
    <string name="fmt_week_range">第%1$d-%2$d週</string>
    <string name="fmt_week_span_single">%1$d週</string>
    <string name="fmt_week_span_range">%1$d-%2$d週</string>
    <string name="fmt_week_type_odd">奇数週</string>
    <string name="fmt_week_type_even">偶数週</string>
    <!-- Compact odd/even marker appended to the week span, e.g. 1-16週·奇 -->
    <string name="fmt_week_span_with_type">%1$s·%2$s</string>
    <string name="fmt_week_type_odd_short">奇</string>
    <string name="fmt_week_type_even_short">偶</string>

    <string name="fmt_period_single">%1$d限</string>
    <string name="fmt_period_range">%1$d-%2$d限</string>

    <plurals name="fmt_remaining_minutes">
        <item quantity="other">%1$d分</item>
    </plurals>
    <plurals name="fmt_remaining_hours">
        <item quantity="other">%1$d時間</item>
    </plurals>
    <!-- 1時間20分: %1$s is fmt_remaining_hours, %2$s is fmt_remaining_minutes -->
    <string name="fmt_remaining_hours_minutes">%1$s%2$s</string>
    <plurals name="fmt_total_weeks">
        <item quantity="other">全%1$d週</item>
    </plurals>

    <!-- Separators. Leading and trailing spaces need the surrounding quotes. -->
    <string name="common_separator">" · "</string>
    <string name="common_list_separator">、</string>
    <!-- Joins short notices inside parentheses; Japanese rarely uses a semicolon -->
    <string name="common_clause_separator">／</string>
    <!-- Japanese sentences already end with 。, so nothing is needed between them -->
    <string name="common_sentence_separator"></string>

    <!-- DateText. Numeric on purpose: month names would come from Locale.getDefault(),
         which the in-app language switch does not change on Android 12 and below. -->
    <string name="fmt_date">%1$d年%2$d月%3$d日</string>
    <string name="fmt_month_day">%1$d月%2$d日</string>
    <string name="fmt_exam_relative_today">今日</string>
    <string name="fmt_exam_relative_tomorrow">明日</string>
    <string name="fmt_exam_relative_yesterday">昨日</string>
    <string name="fmt_exam_relative_past">終了</string>
    <plurals name="fmt_exam_relative_in_days">
        <item quantity="other">%1$d日後</item>
    </plurals>

